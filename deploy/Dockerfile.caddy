# syntax=docker/dockerfile:1
# Stage 1: build the SPA with Vite.
FROM node:22-alpine AS build
WORKDIR /app

# Install deps first so changes to src/ don't bust the npm cache layer.
COPY package.json package-lock.json ./
RUN npm ci

# Bring in the rest of the build context (repo root, scoped by .dockerignore)
# and produce dist/.
COPY . .
RUN npm run build
# Android App Links: bake deploy/assetlinks.json (if present) into the web
# root so https://$DOMAIN/.well-known/assetlinks.json verifies the app's
# signing key. Create it from deploy/assetlinks.json.example with the real
# release-key SHA256 fingerprint (fingerprints are public — safe to commit).
RUN mkdir -p dist/.well-known && \
    if [ -f deploy/assetlinks.json ]; then cp deploy/assetlinks.json dist/.well-known/; fi

# Stage 2: Caddy serves the built static files and reverse-proxies /sync/*.
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /usr/share/caddy
