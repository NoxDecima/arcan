# syntax=docker/dockerfile:1
FROM node:22-alpine

# jazz-run is a SEPARATE npm package from jazz-tools. The CLI binary is
# only present after installing jazz-run, not jazz-tools. Pin the major
# version so unattended docker compose up --build doesn't silently jump
# to a future breaking release.
RUN npm install -g jazz-run@^0.20.0

# WORKDIR under the bind-mount path so the SQLite file lands in the volume
# regardless of relative-path quirks in jazz-run.
WORKDIR /data

EXPOSE 4200
CMD ["jazz-run", "sync", "--host", "0.0.0.0", "--port", "4200", "--db", "/data/sync.sqlite"]
