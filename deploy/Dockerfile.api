# syntax=docker/dockerfile:1
# Build stage — install deps + transpile TS to dist/
FROM node:22-alpine AS build
WORKDIR /build

# Install build toolchain for better-sqlite3 native module (compiled fresh
# in this stage; the runtime stage reuses the compiled .node file).
RUN apk add --no-cache python3 make g++

COPY api/package.json api/package-lock.json ./
RUN npm ci

COPY api/tsconfig.json ./
COPY api/src ./src
RUN npx tsc -b

# Runtime stage — minimal node + sqlite-libs + production deps + dist/
FROM node:22-alpine
RUN apk add --no-cache sqlite-libs python3 make g++

WORKDIR /app
COPY api/package.json api/package-lock.json ./
# --omit=dev: skip tsx / vitest etc. better-sqlite3 still needs python3+make+g++
# for its install hook; remove them after npm ci to keep the image smaller.
RUN npm ci --omit=dev && apk del python3 make g++

COPY --from=build /build/dist ./dist

EXPOSE 4300

# api service runs Better Auth migrations in-process on boot
# (see api/src/index.ts) — no separate migrate step required.
CMD ["node", "dist/index.js"]
