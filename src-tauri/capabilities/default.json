{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Arcan shell capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "notification:default",
    "deep-link:default",
    {
      "identifier": "fs:scope",
      "allow": ["$DOWNLOAD/**", "$APPDATA/**"]
    }
  ],
  "platforms": ["linux", "macOS", "windows", "android", "iOS"]
}
